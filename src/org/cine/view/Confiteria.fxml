<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cine.controller.ConfiteriaController" stylesheets="@style/confiteria.css" prefWidth="1120" prefHeight="700" styleClass="root-pane">
 <top><HBox alignment="CENTER_LEFT" spacing="16" styleClass="header"><Label text="CONFITERÍA" styleClass="titulo"/><Label text="Productos, inventario y ventas" styleClass="subtitulo"/><Region HBox.hgrow="ALWAYS"/><Button text="Volver al dashboard" onAction="#volver"/></HBox></top>
 <center><VBox spacing="12" styleClass="contenido"><HBox spacing="10" alignment="CENTER_LEFT"><TextField fx:id="busqueda" promptText="Buscar producto o categoría" prefWidth="360" onAction="#buscar"/><Button text="Buscar" onAction="#buscar"/><Button text="Actualizar" onAction="#recargar"/></HBox>
 <TableView fx:id="tabla" VBox.vgrow="ALWAYS" prefHeight="330"><columns>
 <TableColumn fx:id="colId" text="ID" prefWidth="45"/><TableColumn fx:id="colNombre" text="Producto" prefWidth="200"/><TableColumn fx:id="colCategoria" text="Categoría" prefWidth="140"/><TableColumn fx:id="colPrecio" text="Precio" prefWidth="105"/><TableColumn fx:id="colStock" text="Stock" prefWidth="70"/><TableColumn fx:id="colMinimo" text="Mínimo" prefWidth="70"/><TableColumn fx:id="colEstado" text="Estado" prefWidth="95"/>
 </columns></TableView>
 <HBox spacing="18" alignment="TOP_LEFT"><VBox spacing="9" prefWidth="520" styleClass="panel"><Label text="Administrar producto" styleClass="seccion"/><HBox spacing="10"><TextField fx:id="nombre" promptText="Nombre" prefWidth="240"/><ComboBox fx:id="categorias" promptText="Categoría" prefWidth="205"/></HBox><TextField fx:id="descripcion" promptText="Descripción"/><HBox spacing="10"><TextField fx:id="precio" promptText="Precio (Q)"/><TextField fx:id="stockMinimo" promptText="Stock mínimo"/></HBox><HBox spacing="8"><Button text="Guardar" onAction="#guardar"/><Button text="Nuevo" onAction="#limpiar"/><Button text="Activar / Desactivar" onAction="#cambiarEstado"/><Button text="Categoría +" onAction="#crearCategoria"/><Button text="Ingresar stock" onAction="#agregarStock"/></HBox></VBox>
 <VBox spacing="9" prefWidth="420" styleClass="panel"><Label text="Venta de confitería" styleClass="seccion"/><Label text="Selecciona un producto en la tabla y un cliente."/><ComboBox fx:id="clientes" promptText="Seleccionar cliente" prefWidth="370"/><HBox spacing="10" alignment="CENTER_LEFT"><Label text="Cantidad:"/><TextField fx:id="cantidad" prefWidth="90"/><Label fx:id="total" text="Total: Q 0.00" styleClass="total"/></HBox><Button text="Confirmar venta en efectivo" onAction="#vender"/></VBox></HBox>
 <Label fx:id="mensaje" text="Listo" wrapText="true" styleClass="mensaje"/></VBox></center>
</BorderPane>
