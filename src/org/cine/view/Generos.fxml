<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="600.0"
            prefWidth="900.0">

    <top>
        <VBox spacing="10.0"
              style="-fx-padding: 20;">

            <Label text="Gestión de Géneros"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <GridPane hgap="10.0"
                      vgap="10.0">

                <Label text="Nombre:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtNombreGenero"
                           promptText="Nombre del género"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"
                           prefWidth="250.0"/>

                <Label text="Descripción:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtDescripcion"
                           promptText="Descripción del género"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"
                           prefWidth="250.0"/>

            </GridPane>

            <HBox spacing="10.0">

                <Button fx:id="btnGuardar"
                        text="Guardar"
                        style="-fx-background-color: #28a745; -fx-text-fill: white;"/>

                <Button fx:id="btnEditar"
                        text="Editar"/>

                <Button fx:id="btnEliminar"
                        text="Eliminar"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>

                <Button fx:id="btnCambiarEstado"
                        text="Activar / Desactivar"/>

                <Button fx:id="btnLimpiar"
                        text="Limpiar"/>

            </HBox>

        </VBox>
    </top>

    <center>
        <TableView fx:id="tbGeneros"
                   BorderPane.alignment="CENTER">

            <columns>

                <TableColumn fx:id="colIdGenero"
                             prefWidth="100.0"
                             text="ID"/>

                <TableColumn fx:id="colNombreGenero"
                             prefWidth="220.0"
                             text="Nombre"/>

                <TableColumn fx:id="colDescripcion"
                             prefWidth="350.0"
                             text="Descripción"/>

                <TableColumn fx:id="colEstado"
                             prefWidth="120.0"
                             text="Estado"/>

            </columns>

        </TableView>
    </center>

</BorderPane>