<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.cine.controller.DashboardTaquilleroController"
      alignment="CENTER"
      spacing="18"
      prefWidth="860.0"
      prefHeight="540.0"
      stylesheets="@style/dashboard.css"
      styleClass="root">

    <padding>
        <Insets top="30.0"
                right="30.0"
                bottom="30.0"
                left="30.0"/>
    </padding>

    <VBox alignment="CENTER"
          spacing="18"
          prefWidth="500.0"
          prefHeight="380.0"
          maxWidth="500.0"
          styleClass="dashboard-card">

        <Label text="CINEMA"
               styleClass="title"/>

        <Label text="Panel de Taquillero"
               styleClass="subtitle"/>

        <Label text="Sesión iniciada correctamente"
               styleClass="subtitle"/>

        <Label fx:id="lblUsuario"
               text="Taquillero"
               styleClass="user"/>

        <Button text="Ver cartelera"
                onAction="#abrirCartelera"
                maxWidth="Infinity"
                styleClass="functions-button"/>

        <Button text="Nueva venta de boletos"
                onAction="#vender"
                maxWidth="Infinity"
                styleClass="functions-button"/>

        <Button text="Cerrar sesión"
                onAction="#cerrarSesion"
                maxWidth="Infinity"
                styleClass="logout-button"/>

    </VBox>

</VBox>