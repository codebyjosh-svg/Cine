<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.cine.controller.CarteleraController"
            prefWidth="1200"
            prefHeight="650"
            stylesheets="@style/cartelera.css"
            styleClass="cartelera-root">

    <!-- ENCABEZADO -->

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="14"
              styleClass="top-bar">

            <padding>
                <Insets top="9" right="18" bottom="9" left="18"/>
            </padding>

            <VBox spacing="1">
                <Label text="CINE"
                       styleClass="brand-label"/>

                <Label text="Sistema de Gestión"
                       styleClass="brand-subtitle"/>
            </VBox>

            <Label text="Cartelera"
                   styleClass="top-section-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnVolver"
                    text="← Regresar al Dashboard"
                    styleClass="back-button"/>
        </HBox>
    </top>


    <!-- CONTENIDO -->

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="main-scroll">

            <content>

                <VBox spacing="10"
                      fillWidth="true"
                      styleClass="content-container">

                    <!-- TITULO -->

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="2">

                            <Label text="Cartelera de funciones"
                                   styleClass="page-title"/>

                            <Label text="Consulta las películas, horarios, salas y precios disponibles."
                                   styleClass="page-subtitle"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox spacing="6"
                              styleClass="status-badge">

                            <Label text="●"
                                   styleClass="status-dot"/>

                            <Label text="Sistema Activo"
                                   styleClass="status-text"/>

                            <Label text="Turno Taquillero"
                                   styleClass="status-text-secondary"/>

                        </HBox>

                    </HBox>


                    <!-- FILTROS -->

                    <VBox spacing="6"
                          styleClass="filter-card">

                        <HBox spacing="9"
                              alignment="BOTTOM_LEFT">

                            <VBox spacing="3"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Buscar película"
                                       styleClass="field-label"/>

                                <TextField fx:id="txtBuscar"
                                           promptText="Buscar por título..."
                                           styleClass="form-field"/>

                            </VBox>


                            <VBox spacing="3"
                                  prefWidth="135">

                                <Label text="Fecha"
                                       styleClass="field-label"/>

                                <DatePicker fx:id="dpFecha"
                                            prefWidth="135"
                                            styleClass="form-date"/>

                            </VBox>


                            <VBox spacing="3"
                                  prefWidth="145">

                                <Label text="Género"
                                       styleClass="field-label"/>

                                <ComboBox fx:id="cbGenero"
                                          prefWidth="145"
                                          promptText="Todos los géneros"
                                          styleClass="form-combo"/>

                            </VBox>


                            <VBox spacing="3"
                                  prefWidth="145">

                                <Label text="Sala"
                                       styleClass="field-label"/>

                                <ComboBox fx:id="cbSala"
                                          prefWidth="145"
                                          promptText="Todas las salas"
                                          styleClass="form-combo"/>

                            </VBox>


                            <Button fx:id="btnFiltrar"
                                    text="Filtrar"
                                    styleClass="button-primary"/>

                            <Button fx:id="btnLimpiar"
                                    text="Limpiar"
                                    styleClass="button-secondary"/>

                        </HBox>

                    </VBox>


                    <!-- TITULO DE RESULTADOS -->

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="1">

                            <Label text="Funciones disponibles"
                                   styleClass="section-title"/>

                            <Label text="Películas actualmente programadas en el cine."
                                   styleClass="section-subtitle"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="CARTELERA"
                               styleClass="section-badge"/>

                    </HBox>

                    <Separator/>


                    <!-- GRID -->

                    <TilePane fx:id="gridCartelera"
                              prefColumns="3"
                              hgap="14"
                              vgap="14"
                              alignment="TOP_LEFT"
                              prefTileWidth="275"
                              prefTileHeight="340"
                              styleClass="movies-grid">


                        <!-- PELICULA 1 -->

                        <VBox prefWidth="275"
                              maxWidth="275"
                              styleClass="movie-card">

                            <StackPane styleClass="poster-container">

                                <ImageView fitWidth="257"
                                           fitHeight="185"
                                           preserveRatio="true"
                                           styleClass="movie-poster"/>

                                <HBox alignment="TOP_RIGHT"
                                      spacing="4"
                                      StackPane.alignment="TOP_RIGHT">

                                    <Label text="Clasificación B"
                                           styleClass="classification-badge"/>

                                    <Label text="Acción"
                                           styleClass="genre-badge"/>

                                </HBox>

                                <Label text="Poster local"
                                       styleClass="poster-placeholder"
                                       StackPane.alignment="CENTER"/>

                            </StackPane>


                            <VBox spacing="4"
                                  styleClass="movie-info">

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="La Última Misión"
                                           styleClass="movie-title"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="Q45.00"
                                           styleClass="movie-price"/>

                                </HBox>

                                <Label text="● 08/10/2026     ◷ 18:30 hrs"
                                       styleClass="movie-detail"/>

                                <Label text="▣ Sala 1 - Principal"
                                       styleClass="movie-detail"/>

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="● 72 asientos disponibles"
                                           styleClass="availability-badge"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="ID: F-1902"
                                           styleClass="movie-id"/>

                                </HBox>

                                <Button text="Ver función"
                                        maxWidth="Infinity"
                                        styleClass="button-ver-funcion"/>

                            </VBox>

                        </VBox>


                        <!-- PELICULA 2 -->

                        <VBox prefWidth="275"
                              maxWidth="275"
                              styleClass="movie-card">

                            <StackPane styleClass="poster-container">

                                <ImageView fitWidth="257"
                                           fitHeight="185"
                                           preserveRatio="true"
                                           styleClass="movie-poster"/>

                                <HBox alignment="TOP_RIGHT"
                                      spacing="4"
                                      StackPane.alignment="TOP_RIGHT">

                                    <Label text="Clasificación A"
                                           styleClass="classification-badge"/>

                                    <Label text="Aventura"
                                           styleClass="genre-badge"/>

                                </HBox>

                                <Label text="Poster local"
                                       styleClass="poster-placeholder"
                                       StackPane.alignment="CENTER"/>

                            </StackPane>


                            <VBox spacing="4"
                                  styleClass="movie-info">

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="La Isla Perdida"
                                           styleClass="movie-title"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="Q40.00"
                                           styleClass="movie-price"/>

                                </HBox>

                                <Label text="● 08/10/2026     ◷ 20:00 hrs"
                                       styleClass="movie-detail"/>

                                <Label text="▣ Sala 2 - 2D"
                                       styleClass="movie-detail"/>

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="● 35 asientos disponibles"
                                           styleClass="availability-badge"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="ID: F-1903"
                                           styleClass="movie-id"/>

                                </HBox>

                                <Button text="Ver función"
                                        maxWidth="Infinity"
                                        styleClass="button-ver-funcion"/>

                            </VBox>

                        </VBox>


                        <!-- PELICULA 3 -->

                        <VBox prefWidth="275"
                              maxWidth="275"
                              styleClass="movie-card">

                            <StackPane styleClass="poster-container">

                                <ImageView fitWidth="257"
                                           fitHeight="185"
                                           preserveRatio="true"
                                           styleClass="movie-poster"/>

                                <HBox alignment="TOP_RIGHT"
                                      spacing="4"
                                      StackPane.alignment="TOP_RIGHT">

                                    <Label text="Clasificación B"
                                           styleClass="classification-badge"/>

                                    <Label text="Ciencia Ficción"
                                           styleClass="genre-badge"/>

                                </HBox>

                                <Label text="Poster local"
                                       styleClass="poster-placeholder"
                                       StackPane.alignment="CENTER"/>

                            </StackPane>


                            <VBox spacing="4"
                                  styleClass="movie-info">

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="Viaje al Espacio"
                                           styleClass="movie-title"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="Q55.00"
                                           styleClass="movie-price"/>

                                </HBox>

                                <Label text="● 08/10/2026     ◷ 19:15 hrs"
                                       styleClass="movie-detail"/>

                                <Label text="▣ Sala 3 - 3D Macro"
                                       styleClass="movie-detail"/>

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="● 48 asientos disponibles"
                                           styleClass="availability-badge"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="ID: F-1904"
                                           styleClass="movie-id"/>

                                </HBox>

                                <Button text="Ver función"
                                        maxWidth="Infinity"
                                        styleClass="button-ver-funcion"/>

                            </VBox>

                        </VBox>


                        <!-- PELICULA 4 -->

                        <VBox prefWidth="275"
                              maxWidth="275"
                              styleClass="movie-card">

                            <StackPane styleClass="poster-container">

                                <ImageView fitWidth="257"
                                           fitHeight="185"
                                           preserveRatio="true"
                                           styleClass="movie-poster"/>

                                <HBox alignment="TOP_RIGHT"
                                      spacing="4"
                                      StackPane.alignment="TOP_RIGHT">

                                    <Label text="Clasificación A"
                                           styleClass="classification-badge"/>

                                    <Label text="Comedia"
                                           styleClass="genre-badge"/>

                                </HBox>

                                <Label text="Poster local"
                                       styleClass="poster-placeholder"
                                       StackPane.alignment="CENTER"/>

                            </StackPane>


                            <VBox spacing="4"
                                  styleClass="movie-info">

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="De Locos"
                                           styleClass="movie-title"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="Q38.00"
                                           styleClass="movie-price"/>

                                </HBox>

                                <Label text="● 08/10/2026     ◷ 17:30 hrs"
                                       styleClass="movie-detail"/>

                                <Label text="▣ Sala 1 - Principal"
                                       styleClass="movie-detail"/>

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="● 61 asientos disponibles"
                                           styleClass="availability-badge"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="ID: F-1905"
                                           styleClass="movie-id"/>

                                </HBox>

                                <Button text="Ver función"
                                        maxWidth="Infinity"
                                        styleClass="button-ver-funcion"/>

                            </VBox>

                        </VBox>


                        <!-- PELICULA 5 -->

                        <VBox prefWidth="275"
                              maxWidth="275"
                              styleClass="movie-card">

                            <StackPane styleClass="poster-container">

                                <ImageView fitWidth="257"
                                           fitHeight="185"
                                           preserveRatio="true"
                                           styleClass="movie-poster"/>

                                <HBox alignment="TOP_RIGHT"
                                      spacing="4"
                                      StackPane.alignment="TOP_RIGHT">

                                    <Label text="Clasificación C"
                                           styleClass="classification-badge"/>

                                    <Label text="Terror"
                                           styleClass="genre-badge"/>

                                </HBox>

                                <Label text="Poster local"
                                       styleClass="poster-placeholder"
                                       StackPane.alignment="CENTER"/>

                            </StackPane>


                            <VBox spacing="4"
                                  styleClass="movie-info">

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="La Casa Oscura"
                                           styleClass="movie-title"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="Q42.00"
                                           styleClass="movie-price"/>

                                </HBox>

                                <Label text="● 08/10/2026     ◷ 21:00 hrs"
                                       styleClass="movie-detail"/>

                                <Label text="▣ Sala 2"
                                       styleClass="movie-detail"/>

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="● 24 asientos disponibles"
                                           styleClass="availability-badge"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="ID: F-1906"
                                           styleClass="movie-id"/>

                                </HBox>

                                <Button text="Ver función"
                                        maxWidth="Infinity"
                                        styleClass="button-ver-funcion"/>

                            </VBox>

                        </VBox>


                        <!-- PELICULA 6 -->

                        <VBox prefWidth="275"
                              maxWidth="275"
                              styleClass="movie-card">

                            <StackPane styleClass="poster-container">

                                <ImageView fitWidth="257"
                                           fitHeight="185"
                                           preserveRatio="true"
                                           styleClass="movie-poster"/>

                                <HBox alignment="TOP_RIGHT"
                                      spacing="4"
                                      StackPane.alignment="TOP_RIGHT">

                                    <Label text="Clasificación A"
                                           styleClass="classification-badge"/>

                                    <Label text="Animación"
                                           styleClass="genre-badge"/>

                                </HBox>

                                <Label text="Poster local"
                                       styleClass="poster-placeholder"
                                       StackPane.alignment="CENTER"/>

                            </StackPane>


                            <VBox spacing="4"
                                  styleClass="movie-info">

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="Colores"
                                           styleClass="movie-title"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="Q40.00"
                                           styleClass="movie-price"/>

                                </HBox>

                                <Label text="● 08/10/2026     ◷ 16:00 hrs"
                                       styleClass="movie-detail"/>

                                <Label text="▣ Sala 3 - 3D Macro"
                                       styleClass="movie-detail"/>

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="● 40 asientos disponibles"
                                           styleClass="availability-badge"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Label text="ID: F-1907"
                                           styleClass="movie-id"/>

                                </HBox>

                                <Button text="Ver función"
                                        maxWidth="Infinity"
                                        styleClass="button-ver-funcion"/>

                            </VBox>

                        </VBox>

                    </TilePane>


                    <!-- INFORMACION -->

                    <HBox spacing="12">

                        <VBox spacing="4"
                              HBox.hgrow="ALWAYS"
                              styleClass="info-card">

                            <Label text="Información"
                                   styleClass="info-title"/>

                            <Label text="La cartelera muestra las funciones programadas y disponibles del cine."
                                   wrapText="true"
                                   styleClass="info-text"/>

                        </VBox>


                        <VBox spacing="4"
                              HBox.hgrow="ALWAYS"
                              styleClass="info-card">

                            <Label text="Próximo paso"
                                   styleClass="info-title"/>

                            <Label text="Seleccione una función para continuar con el proceso de venta."
                                   wrapText="true"
                                   styleClass="info-text"/>

                        </VBox>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>


    <!-- PIE -->

    <bottom>

        <HBox alignment="CENTER_LEFT"
              styleClass="footer-container">

            <padding>
                <Insets top="6"
                        right="18"
                        bottom="6"
                        left="18"/>
            </padding>

            <Label text="● Sistema de Gestión de Cine"
                   styleClass="footer-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Módulo: Cartelera"
                   styleClass="footer-label"/>

        </HBox>

    </bottom>

</BorderPane>