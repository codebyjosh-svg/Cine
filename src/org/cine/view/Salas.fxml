<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.cine.controller.SalasController"
            prefWidth="1150.0"
            prefHeight="720.0"
            minWidth="1050.0"
            minHeight="650.0"
            stylesheets="@style/sala.css"
            styleClass="salas-root">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="16.0"
              styleClass="top-bar">

            <VBox spacing="2.0">

                <Label text="CINEMA"
                       styleClass="brand-label"/>

                <Label text="Sistema de Gestión"
                       styleClass="brand-subtitle"/>

            </VBox>

            <Label text="Gestión de salas y butacas"
                   styleClass="top-section-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="← Regresar al Dashboard"
                    onAction="#regresarDashboard"
                    styleClass="back-button"/>

        </HBox>

    </top>


    <!-- ===================================================== -->
    <!-- CONTENIDO -->
    <!-- ===================================================== -->

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="content-scroll">

            <content>

                <VBox spacing="14.0"
                      styleClass="content-container">

                    <!-- TITULO -->

                    <VBox spacing="2.0"
                          styleClass="page-heading">

                        <Label text="Salas y butacas"
                               styleClass="page-title"/>

                        <Label text="Administra las salas del cine y las butacas asociadas a cada una."
                               styleClass="page-subtitle"/>

                    </VBox>


                    <HBox spacing="14.0"
                          alignment="TOP_LEFT">

                        <!-- ================================================= -->
                        <!-- GESTIÓN DE SALAS -->
                        <!-- ================================================= -->

                        <VBox spacing="10.0"
                              prefWidth="540.0"
                              minWidth="500.0"
                              HBox.hgrow="ALWAYS"
                              styleClass="card">

                            <VBox spacing="2.0">

                                <Label text="Gestión de salas"
                                       styleClass="section-title"/>

                                <Label text="Crea, edita, elimina o cambia el estado de una sala."
                                       styleClass="section-subtitle"/>

                            </VBox>


                            <!-- FORMULARIO -->

                            <GridPane hgap="10.0"
                                      vgap="8.0">

                                <columnConstraints>
                                    <ColumnConstraints minWidth="100.0"
                                                        prefWidth="120.0"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>


                                <Label text="Nombre de sala"
                                       styleClass="field-label"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"/>

                                <TextField fx:id="txtNombreSala"
                                           promptText="Ej. Sala 1"
                                           maxWidth="Infinity"
                                           styleClass="form-field"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="0"/>


                                <Label text="Formato"
                                       styleClass="field-label"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1"/>

                                <ComboBox fx:id="cboFormato"
                                          promptText="Seleccionar formato"
                                          maxWidth="Infinity"
                                          styleClass="form-combo"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="1"/>


                                <Label text="Estado"
                                       styleClass="field-label"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="2"/>

                                <Label fx:id="lblEstadoSala"
                                       text="Nueva sala - se guardará activa"
                                       styleClass="state-label"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="2"/>

                            </GridPane>


                            <!-- BOTONES -->

                            <HBox spacing="7.0"
                                  alignment="CENTER_LEFT">

                                <Button fx:id="btnGuardarSala"
                                        text="Guardar"
                                        onAction="#guardarSala"
                                        styleClass="button-primary"/>

                                <Button fx:id="btnEditarSala"
                                        text="Editar"
                                        onAction="#editarSala"
                                        styleClass="button-secondary"/>

                                <Button fx:id="btnEliminarSala"
                                        text="Eliminar"
                                        onAction="#eliminarSala"
                                        styleClass="button-danger"/>

                                <Button fx:id="btnCambiarEstadoSala"
                                        text="Cambiar estado"
                                        onAction="#cambiarEstadoSala"
                                        styleClass="button-warning"/>

                                <Button text="Limpiar"
                                        onAction="#limpiarFormularioSala"
                                        styleClass="button-secondary"/>

                            </HBox>


                            <Label text="Salas registradas"
                                   styleClass="section-title"/>


                            <!-- TABLA -->

                            <TableView fx:id="tblSalas"
                                       prefHeight="390.0"
                                       VBox.vgrow="ALWAYS">

                                <placeholder>
                                    <Label text="No hay salas para mostrar."/>
                                </placeholder>

                                <columns>

                                    <TableColumn fx:id="colIdSala"
                                                 text="ID"
                                                 prefWidth="55.0"/>

                                    <TableColumn fx:id="colNombreSala"
                                                 text="Sala"
                                                 prefWidth="190.0"/>

                                    <TableColumn fx:id="colFormato"
                                                 text="Formato"
                                                 prefWidth="90.0"/>

                                    <TableColumn fx:id="colEstadoSala"
                                                 text="Estado"
                                                 prefWidth="90.0"/>

                                </columns>

                            </TableView>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- GESTIÓN DE BUTACAS -->
                        <!-- ================================================= -->

                        <VBox spacing="10.0"
                              prefWidth="540.0"
                              minWidth="500.0"
                              HBox.hgrow="ALWAYS"
                              styleClass="card">

                            <VBox spacing="2.0">

                                <Label text="Gestión de butacas"
                                       styleClass="section-title"/>

                                <Label fx:id="lblSalaSeleccionada"
                                       text="Selecciona una sala para consultar sus butacas."
                                       styleClass="section-subtitle"/>

                            </VBox>


                            <!-- FORMULARIO BUTACA -->

                            <GridPane hgap="10.0"
                                      vgap="8.0">

                                <columnConstraints>
                                    <ColumnConstraints minWidth="100.0"
                                                        prefWidth="120.0"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>


                                <Label text="Fila"
                                       styleClass="field-label"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"/>

                                <TextField fx:id="txtFila"
                                           promptText="Ej. A"
                                           maxWidth="Infinity"
                                           styleClass="form-field"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="0"/>


                                <Label text="Número"
                                       styleClass="field-label"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1"/>

                                <TextField fx:id="txtNumeroButaca"
                                           promptText="Ej. 1"
                                           maxWidth="Infinity"
                                           styleClass="form-field"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>


                                <Label text="Estado"
                                       styleClass="field-label"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="2"/>

                                <Label fx:id="lblEstadoButaca"
                                       text="Nueva butaca - se guardará activa"
                                       styleClass="state-label"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="2"/>

                            </GridPane>


                            <!-- BOTONES -->

                            <HBox spacing="7.0"
                                  alignment="CENTER_LEFT">

                                <Button fx:id="btnGuardarButaca"
                                        text="Guardar"
                                        onAction="#guardarButaca"
                                        styleClass="button-primary"/>

                                <Button fx:id="btnEditarButaca"
                                        text="Editar"
                                        onAction="#editarButaca"
                                        styleClass="button-secondary"/>

                                <Button fx:id="btnEliminarButaca"
                                        text="Eliminar"
                                        onAction="#eliminarButaca"
                                        styleClass="button-danger"/>

                                <Button fx:id="btnCambiarEstadoButaca"
                                        text="Cambiar estado"
                                        onAction="#cambiarEstadoButaca"
                                        styleClass="button-warning"/>

                                <Button text="Limpiar"
                                        onAction="#limpiarFormularioButaca"
                                        styleClass="button-secondary"/>

                            </HBox>


                            <Label text="Butacas de la sala seleccionada"
                                   styleClass="section-title"/>


                            <!-- TABLA BUTACAS -->

                            <TableView fx:id="tblButacas"
                                       prefHeight="390.0"
                                       VBox.vgrow="ALWAYS">

                                <placeholder>
                                    <Label text="No hay butacas para mostrar."/>
                                </placeholder>

                                <columns>

                                    <TableColumn fx:id="colIdButaca"
                                                 text="ID"
                                                 prefWidth="55.0"/>

                                    <TableColumn fx:id="colFila"
                                                 text="Fila"
                                                 prefWidth="90.0"/>

                                    <TableColumn fx:id="colNumero"
                                                 text="Número"
                                                 prefWidth="90.0"/>

                                    <TableColumn fx:id="colEstadoButaca"
                                                 text="Estado"
                                                 prefWidth="90.0"/>

                                </columns>

                            </TableView>

                        </VBox>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>