<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.cine.controller.FacturaController"
            stylesheets="@style/factura.css"
            styleClass="factura-root"
            prefWidth="1100.0"
            prefHeight="700.0">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <top>

        <VBox styleClass="header">

            <padding>
                <Insets top="14"
                        right="22"
                        bottom="12"
                        left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="12">

                <VBox spacing="2">

                    <Label text="CINEMA"
                           styleClass="brand-title"/>

                    <Label text="Sistema de Gestión de Cine"
                           styleClass="header-section"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Factura de Venta"
                       styleClass="header-section"/>

                <Button fx:id="btnVolver"
                        text="Regresar al Dashboard"
                        onAction="#volver"
                        styleClass="header-back-button"/>

            </HBox>

        </VBox>

    </top>


    <!-- ===================================================== -->
    <!-- CONTENIDO -->
    <!-- ===================================================== -->

    <center>

        <VBox spacing="14">

            <padding>
                <Insets top="18"
                        right="22"
                        bottom="18"
                        left="22"/>
            </padding>


            <!-- TÍTULO -->

            <HBox alignment="CENTER_LEFT"
                  spacing="12">

                <VBox spacing="3">

                    <Label text="Comprobante de venta"
                           styleClass="titulo"/>

                    <Label text="Boletos y productos de dulcería"
                           styleClass="subtitulo"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnReintentar"
                        text="Actualizar factura"
                        onAction="#reintentar"
                        styleClass="boton-secundario"/>

                <Button fx:id="btnImprimir"
                        text="Imprimir factura"
                        onAction="#imprimir"
                        styleClass="boton-primario"/>

            </HBox>


            <!-- MENSAJE -->

            <Label fx:id="lblMensaje"
                   text="Consultando factura..."
                   wrapText="true"
                   minHeight="35"
                   maxWidth="Infinity"
                   styleClass="mensaje"/>


            <!-- ================================================= -->
            <!-- CUERPO -->
            <!-- ================================================= -->

            <HBox spacing="18"
                  VBox.vgrow="ALWAYS">


                <!-- ================================================= -->
                <!-- FACTURA -->
                <!-- ================================================= -->

                <VBox spacing="12"
                      styleClass="invoice-paper"
                      HBox.hgrow="ALWAYS">


                    <!-- ENCABEZADO FACTURA -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="12">

                        <VBox spacing="3">

                            <Label text="CINEMA GUATEMALA"
                                   styleClass="invoice-company"/>

                            <Label text="COMPROBANTE DE VENTA"
                                   styleClass="invoice-subtitle"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox alignment="CENTER_RIGHT"
                              spacing="3">

                            <Label text="NÚMERO DE FACTURA"
                                   styleClass="small-label"/>

                            <Label fx:id="lblNumeroFactura"
                                   text="—"
                                   styleClass="invoice-number"/>

                            <Label fx:id="lblNumero"
                                   text="Factura"
                                   styleClass="subtitulo"/>

                        </VBox>

                    </HBox>


                    <Separator/>


                    <!-- DATOS -->

                    <HBox spacing="30">

                        <VBox spacing="4"
                              HBox.hgrow="ALWAYS">

                            <Label text="CLIENTE"
                                   styleClass="field-label"/>

                            <Label fx:id="lblCliente"
                                   text="—"
                                   styleClass="field-value"
                                   wrapText="true"/>

                        </VBox>


                        <VBox spacing="4"
                              HBox.hgrow="ALWAYS">

                            <Label text="ATENDIDO POR"
                                   styleClass="field-label"/>

                            <Label fx:id="lblTaquillero"
                                   text="—"
                                   styleClass="field-value"
                                   wrapText="true"/>

                        </VBox>


                        <VBox spacing="4"
                              prefWidth="160">

                            <Label text="FECHA"
                                   styleClass="field-label"/>

                            <Label fx:id="lblFecha"
                                   text="—"
                                   styleClass="field-value"/>

                        </VBox>


                        <VBox spacing="4"
                              prefWidth="130">

                            <Label text="ESTADO"
                                   styleClass="field-label"/>

                            <Label fx:id="lblEstado"
                                   text="SIN CONSULTAR"
                                   styleClass="status-confirmed"/>

                        </VBox>

                    </HBox>


                    <Separator/>


                    <!-- DETALLE -->

                    <VBox spacing="6"
                          VBox.vgrow="ALWAYS">

                        <Label text="DETALLE DE LA COMPRA"
                               styleClass="detail-title"/>

                        <TableView fx:id="tblFactura"
                                   VBox.vgrow="ALWAYS"
                                   minHeight="180">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>

                                <TableColumn fx:id="colTipo"
                                             text="Tipo"
                                             prefWidth="90"/>

                                <TableColumn fx:id="colDescripcion"
                                             text="Descripción"
                                             prefWidth="300"/>

                                <TableColumn fx:id="colCantidad"
                                             text="Cant."
                                             prefWidth="60"/>

                                <TableColumn fx:id="colPrecio"
                                             text="Precio unitario"
                                             prefWidth="120"/>

                                <TableColumn fx:id="colSubtotal"
                                             text="Subtotal"
                                             prefWidth="120"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- DETALLE DE TEXTO -->

                    <VBox spacing="5">

                        <Label text="DETALLE DEL COMPROBANTE"
                               styleClass="field-label"/>

                        <TextArea fx:id="txtFactura"
                                  editable="false"
                                  wrapText="true"
                                  prefRowCount="3"
                                  maxHeight="80"
                                  styleClass="invoice-detail"/>

                    </VBox>


                    <!-- TOTALES -->

                    <HBox alignment="CENTER_RIGHT"
                          spacing="28">

                        <VBox spacing="4">

                            <Label text="SUBTOTAL BOLETOS"
                                   styleClass="kpi-etiqueta"/>

                            <Label fx:id="lblSubtotalBoletos"
                                   text="Q 0.00"
                                   styleClass="importe"/>

                        </VBox>


                        <VBox spacing="4">

                            <Label text="SUBTOTAL DULCERÍA"
                                   styleClass="kpi-etiqueta"/>

                            <Label fx:id="lblSubtotalProductos"
                                   text="Q 0.00"
                                   styleClass="importe"/>

                        </VBox>


                        <VBox spacing="4">

                            <Label text="TOTAL GENERAL"
                                   styleClass="kpi-etiqueta"/>

                            <Label fx:id="lblTotal"
                                   text="Q 0.00"
                                   styleClass="total"/>

                        </VBox>

                    </HBox>


                    <Label text="Gracias por su compra. Disfrute de la función."
                           styleClass="subtitulo"/>

                </VBox>


                <!-- ================================================= -->
                <!-- PANEL LATERAL -->
                <!-- ================================================= -->

                <VBox spacing="14"
                      prefWidth="250">


                    <!-- CONSULTAR -->

                    <VBox spacing="10"
                          styleClass="side-card">

                        <Label text="CONSULTA DE FACTURA"
                               styleClass="side-title"/>

                        <Label text="Número de factura"
                               styleClass="field-label"/>

                        <TextField fx:id="txtIdVenta"
                                   promptText="Ej. 15"
                                   onAction="#consultar"
                                   styleClass="invoice-search"/>

                        <Button text="Consultar factura"
                                onAction="#consultar"
                                maxWidth="Infinity"
                                styleClass="consult-button"/>

                    </VBox>


                    <!-- OPERACIONES -->

                    <VBox spacing="10"
                          styleClass="side-card">

                        <Label text="OPERACIONES"
                               styleClass="side-title"/>

                        <Button fx:id="btnNuevaVenta"
                                text="Nueva venta"
                                onAction="#nuevaVenta"
                                maxWidth="Infinity"
                                styleClass="side-button"/>

                        <Button text="Nueva factura"
                                onAction="#nuevaFactura"
                                maxWidth="Infinity"
                                styleClass="side-button"/>

                        <Button text="Reimprimir comprobante"
                                onAction="#reimprimir"
                                maxWidth="Infinity"
                                styleClass="side-button"/>

                    </VBox>


                    <!-- INFORMACIÓN -->

                    <VBox spacing="7"
                          styleClass="side-card">

                        <Label text="DATOS DEL EMISOR"
                               styleClass="side-title"/>

                        <Label text="CINEMA GUATEMALA"
                               styleClass="emisor-main"/>

                        <Label text="Sistema de Gestión de Cine"
                               styleClass="emisor-detail"/>

                        <Label text="Guatemala"
                               styleClass="emisor-detail"
                               wrapText="true"/>

                        <Separator/>

                        <Label text="Este comprobante se consulta directamente desde el sistema."
                               wrapText="true"
                               styleClass="emisor-detail"/>

                    </VBox>


                    <!-- ESTADO -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="7"
                          styleClass="system-status">

                        <Label text="●"
                               styleClass="status-dot"/>

                        <Label text="Documento listo para consulta"
                               styleClass="system-status-text"/>

                    </HBox>

                </VBox>

            </HBox>

        </VBox>

    </center>


    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <bottom>

        <BorderPane styleClass="footer">

            <padding>
                <Insets top="7"
                        right="20"
                        bottom="7"
                        left="20"/>
            </padding>

            <left>

                <Label text="Sistema de Gestión de Cine"
                       styleClass="footer-text"/>

            </left>

            <right>

                <Label text="CINEMA 1.0"
                       styleClass="footer-text"/>

            </right>

        </BorderPane>

    </bottom>

</BorderPane>