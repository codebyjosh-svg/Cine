<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="650.0"
            minWidth="1000.0"
            prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="16.0"
              style="-fx-background-color: #172554; -fx-padding: 14 22 14 22;">

            <VBox spacing="2.0">
                <Label text="CINE"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Sistema de Gestión"
                       style="-fx-font-size: 11px; -fx-text-fill: #cbd5e1;"/>
            </VBox>

            <Label text="Gestión de salas y butacas"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnRegresar"
                    text="← Regresar al Dashboard"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14.0"
              style="-fx-padding: 22; -fx-background-color: #f4f6fb;">

            <VBox spacing="3.0">
                <Label text="Salas y butacas"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #172554;"/>
                <Label text="Consulta las salas del cine y las butacas asociadas a cada una."
                       style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
            </VBox>

            <HBox spacing="14.0" VBox.vgrow="ALWAYS">

                <VBox spacing="10.0"
                      minWidth="390.0"
                      prefWidth="430.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 16;">

                    <VBox spacing="2.0">
                        <Label text="Salas registradas"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #172554;"/>
                        <Label text="Selecciona una sala para consultar sus butacas."
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                    </VBox>

                    <TableView fx:id="tblSalas"
                               minHeight="0.0"
                               prefHeight="420.0"
                               VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="No hay salas para mostrar."/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colIdSala"
                                         prefWidth="55.0"
                                         text="ID"/>
                            <TableColumn fx:id="colNombreSala"
                                         prefWidth="170.0"
                                         text="Sala"/>
                            <TableColumn fx:id="colFormato"
                                         prefWidth="75.0"
                                         text="Formato"/>
                            <TableColumn fx:id="colEstadoSala"
                                         prefWidth="80.0"
                                         text="Estado"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10.0"
                      minWidth="420.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 16;">

                    <VBox spacing="2.0">
                        <Label text="Butacas de la sala"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #172554;"/>
                        <Label fx:id="lblSalaSeleccionada"
                               text="Selecciona una sala para ver sus butacas."
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                    </VBox>

                    <TableView fx:id="tblButacas"
                               minHeight="0.0"
                               prefHeight="420.0"
                               VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="No hay butacas para mostrar."/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colIdButaca"
                                         prefWidth="65.0"
                                         text="ID"/>
                            <TableColumn fx:id="colFila"
                                         prefWidth="90.0"
                                         text="Fila"/>
                            <TableColumn fx:id="colNumero"
                                         prefWidth="100.0"
                                         text="Número"/>
                            <TableColumn fx:id="colEstadoButaca"
                                         prefWidth="95.0"
                                         text="Estado"/>
                        </columns>
                    </TableView>
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>
