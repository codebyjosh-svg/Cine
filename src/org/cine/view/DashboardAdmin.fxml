<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane prefHeight="540.0" prefWidth="860.0" stylesheets="@style/dashboard.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cine.controller.DashboardController">
    <children>
        <VBox alignment="CENTER" layoutX="180.0" layoutY="60.0" prefHeight="420.0" prefWidth="500.0" spacing="14.0" styleClass="dashboard-card">
            <children>
                <Label text="Dashboard Admin" styleClass="title" />
                <Label text="Sesión iniciada correctamente" styleClass="subtitle" />
                <Label fx:id="lblUsuario" styleClass="user" />
                <Label fx:id="lblRol" styleClass="role" />
                <Button fx:id="btnUsuarios" prefWidth="180.0" prefHeight="36.0" mnemonicParsing="false" onAction="#abrirUsuarios" text="Usuarios" />
                <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesión" styleClass="logout-button" />
            </children>
        </VBox>
    </children>
</AnchorPane>
