<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.cine.controller.ClienteController"
            prefHeight="650.0"
            prefWidth="1050.0">

    <top>
        <VBox spacing="10.0"
              style="-fx-padding: 20;">

            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Gestión de Clientes"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Button text="Volver al dashboard" onAction="#volver"/>
            </HBox>

            <GridPane hgap="10.0"
                      vgap="10.0">

                <Label text="CUI:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtCui"
                           promptText="13 dígitos (opcional)"
                           prefWidth="280.0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Nombres:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtNombreCliente"
                           promptText="Nombres del cliente"
                           prefWidth="280.0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Apellidos:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtApellidoCliente"
                           promptText="Apellidos del cliente"
                           prefWidth="280.0"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="1"/>

                <Label text="Correo:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtCorreoElectronico"
                           promptText="Correo electrónico"
                           prefWidth="280.0"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Teléfono:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtTelefono"
                           promptText="Teléfono (opcional)"
                           prefWidth="280.0"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="2"/>

                <Label text="Estado:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <Label fx:id="lblEstado"
                       text="Nuevo - se guardará como Activo"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="3"/>

            </GridPane>

            <HBox spacing="10.0">

                <Button fx:id="btnGuardar"
                        onAction="#guardarCliente"
                        text="Guardar"/>

                <Button fx:id="btnEditar"
                        onAction="#editarCliente"
                        text="Editar"/>

                <Button fx:id="btnEliminar"
                        onAction="#eliminarCliente"
                        text="Eliminar"/>

                <Button fx:id="btnActivar"
                        onAction="#activarCliente"
                        text="Activar"/>

                <Button fx:id="btnDesactivar"
                        onAction="#desactivarCliente"
                        text="Desactivar"/>

                <Button fx:id="btnLimpiar"
                        onAction="#limpiarFormulario"
                        text="Limpiar"/>

                <Button fx:id="btnActualizar"
                        onAction="#cargarClientes"
                        text="Actualizar"/>

            </HBox>

        </VBox>
    </top>

    <center>
        <TableView fx:id="tbClientes"
                   onMouseClicked="#seleccionarCliente">

            <placeholder>
                <Label text="No hay clientes para mostrar."/>
            </placeholder>

            <columns>

                <TableColumn fx:id="colIdCliente"
                             prefWidth="60.0"
                             text="ID"/>

                <TableColumn fx:id="colCui"
                             prefWidth="130.0"
                             text="CUI"/>

                <TableColumn fx:id="colNombreCliente"
                             prefWidth="150.0"
                             text="Nombres"/>

                <TableColumn fx:id="colApellidoCliente"
                             prefWidth="150.0"
                             text="Apellidos"/>

                <TableColumn fx:id="colCorreoElectronico"
                             prefWidth="210.0"
                             text="Correo"/>

                <TableColumn fx:id="colTelefono"
                             prefWidth="110.0"
                             text="Teléfono"/>

                <TableColumn fx:id="colEstado"
                             prefWidth="80.0"
                             text="Estado"/>

                <TableColumn fx:id="colFechaRegistro"
                             prefWidth="150.0"
                             text="Fecha de registro"/>

            </columns>

        </TableView>
    </center>

</BorderPane>