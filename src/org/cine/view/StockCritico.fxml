<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefWidth="1180" prefHeight="720" styleClass="cine-root"
            stylesheets="@style/operaciones.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cine.controller.StockCriticoController">
    <left>
        <VBox spacing="16" prefWidth="190" minWidth="190" maxWidth="190" styleClass="operacion-sidebar">
            <Label text="CINEMA" styleClass="marca"/>
            <Label text="CONTROL DE DULCERÍA" styleClass="sidebar-caption" wrapText="true"/>
            <Label text="Stock crítico" styleClass="sidebar-activo" maxWidth="Infinity"/>
            <Label text="La reposición ayuda a mantener disponibles los productos del cine." styleClass="sidebar-texto" wrapText="true"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Regla de alerta" styleClass="sidebar-caption"/>
            <Label text="Stock menor o igual al mínimo" styleClass="sidebar-texto" wrapText="true"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="16">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4">
                    <Label text="Productos con stock crítico" styleClass="titulo"/>
                    <Label text="Existencias actuales de productos activos" styleClass="subtitulo"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolver" text="Volver" onAction="#volver" styleClass="boton-secundario"/>
            </HBox>
            <HBox spacing="16">
                <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <Label text="PRODUCTOS CRÍTICOS" styleClass="kpi-etiqueta"/>
                    <Label fx:id="lblCriticos" text="—" styleClass="kpi-numero"/>
                </VBox>
                <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <Label text="SIN EXISTENCIAS" styleClass="kpi-etiqueta"/>
                    <Label fx:id="lblAgotados" text="—" styleClass="kpi-alerta"/>
                </VBox>
            </HBox>
            <Label fx:id="lblMensaje" text="Consultando existencias..." wrapText="true" maxWidth="Infinity" minHeight="44" styleClass="mensaje"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtFiltro" promptText="Buscar producto, categoría o ID" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbNivel" prefWidth="180"/>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizar" styleClass="boton-primario"/>
            </HBox>
            <TableView fx:id="tblStockCritico" VBox.vgrow="ALWAYS" minHeight="140">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="275"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="150"/>
                    <TableColumn fx:id="colStock" text="Stock actual" prefWidth="110"/>
                    <TableColumn fx:id="colMinimo" text="Stock mínimo" prefWidth="110"/>
                    <TableColumn fx:id="colNivel" text="Nivel de alerta" prefWidth="165"/>
                </columns>
            </TableView>
            <Label fx:id="lblResultados" text="0 productos mostrados" styleClass="subtitulo"/>
        </VBox>
    </center>
</BorderPane>
