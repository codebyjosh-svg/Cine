<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cine.controller.ReportesController" stylesheets="@style/reportes.css">
 <top><VBox spacing="12" styleClass="report-header"><padding><Insets top="22" right="24" bottom="20" left="24"/></padding>
  <Label text="REPORTES DE VENTAS" styleClass="title"/>
  <Label text="Consulta todas las ventas confirmadas por día, semana o mes." styleClass="subtitle"/>
  <HBox spacing="12" alignment="CENTER_LEFT"><Label text="Período:"/><ComboBox fx:id="cmbPeriodo" prefWidth="150"/><Label text="Fecha de referencia:"/><DatePicker fx:id="dpFecha"/><Button text="Actualizar" onAction="#filtrar"/><Button text="Volver al dashboard" onAction="#volver"/></HBox>
 </VBox></top>
 <center><VBox spacing="14"><padding><Insets top="18" right="24" bottom="18" left="24"/></padding>
  <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS" placeholder="No hay ventas para mostrar">
   <columns><TableColumn fx:id="colId" text="No. venta" prefWidth="90"/><TableColumn fx:id="colFecha" text="Fecha" prefWidth="145"/><TableColumn fx:id="colCliente" text="Cliente" prefWidth="210"/><TableColumn fx:id="colTaquillero" text="Taquillero" prefWidth="180"/><TableColumn fx:id="colBoletos" text="Boletos" prefWidth="90"/><TableColumn fx:id="colTotal" text="Total" prefWidth="140"/></columns>
  </TableView>
  <HBox alignment="CENTER_RIGHT" spacing="28"><Label fx:id="lblCantidad" text="Ventas: 0" styleClass="summary"/><Label fx:id="lblTotal" text="Total: Q 0.00" styleClass="summary"/></HBox>
  <Label fx:id="lblEstado" text="" wrapText="true" styleClass="status"/>
 </VBox></center>
</BorderPane>
