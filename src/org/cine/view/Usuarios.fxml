<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.cine.controller.UsuarioController" stylesheets="@style/usuarios.css">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="cabecera">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label text="Cine - Gestión de usuarios" styleClass="titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVolver" text="Volver" onAction="#onVolver"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="12">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <VBox prefWidth="300" minWidth="300" maxWidth="300" spacing="10" styleClass="formulario">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="6">
                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                            <Label fx:id="lblModo" text="Nuevo usuario" styleClass="subtitulo"/>
                            <HBox spacing="8">
                                <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Nombre *"/>
                                    <TextField fx:id="txtNombre" promptText="Nombre"/>
                                </VBox>
                                <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Apellido *"/>
                                    <TextField fx:id="txtApellido" promptText="Apellido"/>
                                </VBox>
                            </HBox>
                            <Label text="Username *"/>
                            <TextField fx:id="txtUsername" promptText="Ejemplo: diego.cine"/>
                            <Label text="Correo *"/>
                            <TextField fx:id="txtCorreo" promptText="usuario@ejemplo.com"/>
                            <Label text="Rol *"/>
                            <ComboBox fx:id="cmbRol" promptText="Selecciona un rol" maxWidth="Infinity"/>
                            <VBox fx:id="bloqueCliente" spacing="4" visible="false" managed="false">
                                <Label text="Cliente *"/>
                                <ComboBox fx:id="cmbCliente" promptText="Selecciona un cliente" maxWidth="Infinity"/>
                            </VBox>
                            <Label text="Contraseña *"/>
                            <PasswordField fx:id="txtContrasena" promptText="Mínimo 8 caracteres"/>
                            <Label text="Confirmar contraseña *"/>
                            <PasswordField fx:id="txtConfirmacion" promptText="Repite la contraseña"/>
                            <Label text="Al editar, deja las contraseñas vacías para mantener la actual."
                                   wrapText="true" styleClass="ayuda"/>
                            <Label text="* Campos obligatorios" styleClass="ayuda"/>
                        </VBox>
                    </content>
                </ScrollPane>
                <HBox spacing="8">
                    <padding><Insets top="0" right="12" bottom="12" left="12"/></padding>
                    <Button fx:id="btnGuardar" text="Guardar" onAction="#onGuardar"/>
                    <Button fx:id="btnNuevo" text="Nuevo" onAction="#onNuevo"/>
                </HBox>
            </VBox>
            <VBox spacing="10" minWidth="0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Lista de usuarios" styleClass="subtitulo"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizar"/>
                </HBox>
                <HBox spacing="8">
                    <TextField fx:id="txtBusqueda" promptText="Buscar nombre, username, correo o rol" HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="cmbFiltroEstado" prefWidth="115" minWidth="115"/>
                </HBox>
                <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS" minHeight="180">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
                        <TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="155"/>
                        <TableColumn fx:id="colUsername" text="Username" prefWidth="130"/>
                        <TableColumn fx:id="colRol" text="Rol" prefWidth="80"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="80"/>
                        <TableColumn fx:id="colCorreo" text="Correo" prefWidth="205"/>
                        <TableColumn fx:id="colCliente" text="Cliente ID" prefWidth="85"/>
                        <TableColumn fx:id="colFecha" text="Fecha de registro" prefWidth="170"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Button fx:id="btnEditar" text="Editar" onAction="#onEditar"/>
                    <Button fx:id="btnEstado" text="Desactivar" onAction="#onCambiarEstado"/>
                    <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblResultados" text="0 usuarios"/>
                </HBox>
                <Label fx:id="lblError" text="" wrapText="true" maxWidth="Infinity" styleClass="error"/>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox styleClass="pie">
            <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
            <Label fx:id="lblStatus" text="Cargando datos..." wrapText="true"/>
        </HBox>
    </bottom>
</BorderPane>
